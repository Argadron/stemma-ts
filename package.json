{
  "name": "stemma-ts",
  "version": "1.2.2",
  "description": "Typescript game engine for all games",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && tsc-alias",
    "start:dev": "npm run build && node --import tsx --watch test/gametest.ts",
    "test": "jest",
    "prepare": "npx tsc && npx tsc-alias"
  },
  "keywords": [
    "typescript-game",
    "game",
    "game-engine",
    "ts-game",
    "ts-game-engine",
    "stemma",
    "stemma-ts",
    "js-game"
  ],
  "author": "Argadron",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "tsc-alias": ">=1.8.0",
    "typescript": ">=5.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": ">=1.8.0",
    "tsx": "^4.21.0",
    "typescript": ">=5.0.0"
  }
}
